			"locked": false,
			"fontSize": 36,
			"fontFamily": 1,
			"text": "对参考资料的评价",
			"rawText": "对参考资料的评价",
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "对参考资料的评价",
